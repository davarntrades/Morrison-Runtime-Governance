# Copy to .env and fill in. NEVER commit real values.
# Each variable is routed only to the process that needs it (collection_agent/launcher.py).

# Stripe TEST-mode secret key (sk_test_... or rk_test_...). Given to the executor
# and to the operator/auditor harness ONLY. Live-mode keys are refused.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: Claude for natural-language interpretation (agent process only).
ANTHROPIC_API_KEY=
COLLECTION_AGENT_MODEL=claude-opus-5-5

# Optional: also email the finalized invoice from Stripe (test mode only emails
# addresses on your Stripe team). 0 = finalize only and expose the hosted link.
STRIPE_SEND_INVOICE=0

# Path to the Morrison Runtime Governance repository (provides morrison_governance).
MORRISON_REPO=..
